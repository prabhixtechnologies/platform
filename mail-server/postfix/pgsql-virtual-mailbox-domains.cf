# Postfix pgsql map — domains we accept inbound mail for.
# Matches mail_domains where the org has chosen self-hosted transport and verified DNS.

user = prabhix
password = prabhix
hosts = postgres
dbname = prabhix

query = SELECT 1 FROM mail_domains
        WHERE domain = '%s'
          AND mode = 'SELF_HOSTED'
          AND status IN ('VERIFIED', 'VERIFYING')
          AND deleted_at IS NULL
