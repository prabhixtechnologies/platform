# Public API base URL (Spring Boot backend)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Organization slug for visitor tracking and live chat (seeded as prabhix-platform)
NEXT_PUBLIC_ORG_SLUG=prabhix-platform

# Organization UUID for chat SSE stream (same org as slug above)
NEXT_PUBLIC_ORG_ID=00000000-0000-4000-8000-000000000001

# ---------------------------------------------------------------------------
# URLs — set these for the environment you are building for.
# Docker local compose (Infra/docker-compose.local.yml) injects localhost values
# at image build time. `npm run dev` reads this file / .env.local.
# Production builds must use the https://… hostnames, never localhost defaults.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONSOLE_URL=http://localhost:5173
NEXT_PUBLIC_MOBISTACK_URL=http://localhost:5176
NEXT_PUBLIC_MAILROOM_URL=http://localhost:5175
NEXT_PUBLIC_STORE_URL=http://store.prabhixtechnologies.com:8090
NEXT_PUBLIC_IDENTITY_ISSUER=http://localhost:8081
