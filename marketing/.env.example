# Public API base URL (Spring Boot backend)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Organization slug for visitor tracking and live chat (from console org settings)
NEXT_PUBLIC_ORG_SLUG=

# Organization UUID for chat SSE stream (same org as slug above)
NEXT_PUBLIC_ORG_ID=

# Canonical site URL (used for sitemap, OG metadata)
NEXT_PUBLIC_SITE_URL=https://prabhixtechnologies.com

# Customer console / app URL (Sign in link in header)
NEXT_PUBLIC_CONSOLE_URL=https://app.prabhixtechnologies.com
